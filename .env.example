# ── Travelo Environment Variables ──
# Copy this file to .env and fill in your values
# NEVER commit the actual .env file to version control

# Server
NODE_ENV=development
PORT=3000

# MongoDB
DB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/<dbname>?retryWrites=true&w=majority

# Session
SESSION_SECRET=generate_a_long_random_string_here_at_least_32_chars

# Google OAuth 2.0 (optional)
CLIENT_ID=your_google_client_id.apps.googleusercontent.com
CLIENT_SECRET=your_google_client_secret
CALLBACK_URL=http://localhost:3000/auth/google/callback

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_SECRET=your_razorpay_key_secret

# CORS (optional — set to your frontend domain in production)
# CORS_ORIGIN=https://yourdomain.com

# Logging (optional)
# LOG_LEVEL=info
