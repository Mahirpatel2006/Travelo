{{#section 'styles'}}
<style>

body { font-family: 'Inter', sans-serif !important; text-transform: none !important; }



/* ── Auth Page ── */
.auth-page {
  min-height: 100vh;
  background: linear-gradient(135deg, rgba(41,165,163,.08) 0%, rgba(41,165,163,.2) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 9.6rem 2.4rem 4.8rem;
}

.auth-wrapper {
  display: flex;
  align-items: center;
  gap: 4.8rem;
  max-width: 900px;
  width: 100%;
}

/* Form Card */
.auth-card {
  max-width: 380px;
  width: 100%;
  background: #f8f9fd;
  background: linear-gradient(0deg, rgb(255,255,255) 0%, rgb(244,247,251) 100%);
  border-radius: 28px;
  padding: 4rem 3.6rem;
  border: 4px solid #fff;
  box-shadow: rgba(133,189,215,.88) 0px 30px 30px -20px;
  flex-shrink: 0;
}

.auth-heading {
  text-align: center;
  font-weight: 900;
  font-size: 2.8rem;
  color: #208886;
  margin-bottom: 0.4rem;
  text-transform: none !important;
}

.auth-subheading {
  text-align: center;
  font-size: 1.44rem;
  color: #4a5568;
  margin-bottom: 2rem;
  text-transform: none !important;
}

.auth-error {
  background: rgba(220,53,69,.1);
  border: 1px solid rgba(220,53,69,.25);
  color: #dc3545;
  padding: 0.96rem 1.6rem;
  border-radius: 10px;
  font-size: 1.36rem;
  text-align: center;
  margin-bottom: 1.6rem;
  text-transform: none !important;
}

.auth-form { margin-top: 0.8rem; }

.auth-input {
  width: 100%;
  background: #fff;
  border: none;
  padding: 1.44rem 2rem;
  border-radius: 14px;
  margin-top: 1.2rem;
  box-shadow: #cff0ff 0px 10px 10px -5px;
  border-inline: 2px solid transparent;
  font-size: 1.52rem;
  font-family: inherit;
  color: #1a202c;
  text-transform: none !important;
  outline: none;
  transition: border-color .2s;
}

.auth-input::placeholder { color: #aaa; }
.auth-input:focus { border-inline: 2px solid #29a5a3; }

.auth-btn {
  display: block;
  width: 100%;
  font-weight: 700;
  background: linear-gradient(135deg, #29a5a3 0%, #1e7e7c 100%);
  color: #fff;
  padding: 1.44rem;
  margin: 2rem auto 0.8rem;
  border-radius: 14px;
  box-shadow: rgba(41,165,163,.5) 0px 15px 20px -12px;
  border: none;
  cursor: pointer;
  font-size: 1.6rem;
  font-family: inherit;
  transition: all .2s;
  text-transform: none !important;
}

.auth-btn:hover { transform: scale(1.02); box-shadow: rgba(41,165,163,.5) 0px 20px 20px -14px; }
.auth-btn:active { transform: scale(0.97); }

.auth-btn-alt {
  background: linear-gradient(135deg, #2d3748 0%, #1a202c 100%);
  box-shadow: rgba(45,55,72,.4) 0px 15px 20px -12px;
  margin-top: 0.8rem;
}

.auth-btn-alt:hover { box-shadow: rgba(45,55,72,.4) 0px 20px 20px -14px; }

.auth-agreement {
  display: block;
  text-align: center;
  margin-top: 1.6rem;
}

.auth-agreement a {
  text-decoration: none;
  color: #208886;
  font-size: 1.2rem;
}

.auth-agreement a:hover { text-decoration: underline; }

/* Right side hero text */
.auth-hero {
  flex: 1;
  text-align: left;
}

.auth-hero-img {
  width: 100%;
  max-width: 380px;
  border-radius: 20px;
  object-fit: cover;
  margin-bottom: 2.4rem;
}

.auth-hero-title {
  font-family: 'Playfair Display', Georgia, serif;
  font-size: 5.6rem;
  font-weight: 700;
  color: #1a202c;
  line-height: 1.1;
  text-transform: none !important;
}

.auth-hero-sub {
  font-size: 3.2rem;
  color: #208886;
  font-weight: 600;
  margin-top: 0.4rem;
  text-transform: none !important;
}

/* Responsive */
@media (max-width: 768px) {
  .header { padding: 1.6rem 2.4rem !important; }
  #menu-btn { display: inline-block !important; }
  .header .btn, .header-actions { display: none !important; }

  .auth-wrapper { flex-direction: column; }
  .auth-hero { display: none; }
  .auth-card { max-width: 100%; }
}
</style>
{{/section}}

<div class="auth-page">
  <div class="auth-wrapper">

    <!-- Auth Card -->
    <div class="auth-card">
      <div class="auth-heading">Welcome to Travelo</div>
      <div class="auth-subheading">Sign up or sign in to continue</div>

      {{#if error}}
        <div class="auth-error">{{error}}</div>
      {{/if}}

      <form class="auth-form" action="/auth/register" method="POST">
        <input type="hidden" name="_csrf" value="{{csrfToken}}">
        <input class="auth-input" placeholder="Full Name" id="name" name="name" type="text" autocomplete="name">
        <input class="auth-input" placeholder="Email Address" id="email" name="email" type="email" required autocomplete="email">
        <input class="auth-input" placeholder="Password (min 8 characters)" id="password" name="password" type="password" required minlength="8" autocomplete="new-password">
        <input class="auth-input" placeholder="Confirm Password" id="cpassword" name="cpassword" type="password" autocomplete="new-password">

        <button type="submit" class="auth-btn">Create Account</button>
        <button type="submit" formaction="/auth/login" class="auth-btn auth-btn-alt">Sign In</button>
      </form>

      <span class="auth-agreement"><a href="#">By continuing you agree to our Terms & Privacy Policy</a></span>
    </div>

    <!-- Hero side -->
    <div class="auth-hero">
      <img class="auth-hero-img" src="/images/common/designer-2.png" alt="Travel illustration">
      <div class="auth-hero-title">Live Your</div>
      <div class="auth-hero-sub">Dream Life ✈️</div>
    </div>

  </div>
</div>