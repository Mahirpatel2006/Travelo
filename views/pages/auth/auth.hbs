{{#section 'styles'}}
<style>
  /* ── Variables & Setup ── */
  :root {
    --primary: #29a5a3;
    --primary-dark: #1e7a78;
    --primary-light: rgba(41, 165, 163, 0.1);
    --secondary: #1a202c;
    --text-muted: #718096;
    --glass: rgba(255, 255, 255, 0.85);
    --glass-border: rgba(255, 255, 255, 0.5);
    --shadow: 0 20px 40px -10px rgba(0, 0, 0, 0.1);
  }

  body { 
    font-family: 'Inter', sans-serif !important; 
    text-transform: none !important; 
    overflow-x: hidden;
  }

  /* ── Animated Background ── */
  .auth-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8rem 2.4rem;
    position: relative;
    background: #f0f4f8;
    background: radial-gradient(at 0% 0%, rgba(41, 165, 163, 0.15) 0px, transparent 50%),
                radial-gradient(at 100% 0%, rgba(30, 122, 120, 0.1) 0px, transparent 50%),
                radial-gradient(at 100% 100%, rgba(41, 165, 163, 0.15) 0px, transparent 50%),
                radial-gradient(at 0% 100%, rgba(30, 122, 120, 0.1) 0px, transparent 50%);
  }

  .auth-page::before {
    content: '';
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    background: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
    opacity: 0.03;
    pointer-events: none;
  }

  /* ── Wrapper & Layout ── */
  .auth-wrapper {
    display: flex;
    align-items: stretch;
    background: var(--glass);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-radius: 4rem;
    overflow: hidden;
    max-width: 1100px;
    width: 100%;
    box-shadow: 0 40px 100px -20px rgba(0, 0, 0, 0.15);
    border: 1px solid var(--glass-border);
    animation: slideUp 0.8s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  @keyframes slideUp {
    from { opacity: 0; transform: translateY(40px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* ── Left Side: Form ── */
  .auth-left {
    flex: 1.2;
    padding: 6.4rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .auth-header {
    margin-bottom: 4rem;
  }

  .auth-logo {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    margin-bottom: 2.4rem;
    text-decoration: none;
  }

  .auth-logo i {
    font-size: 3.2rem;
    color: var(--primary);
  }

  .auth-logo span {
    font-size: 2.4rem;
    font-weight: 800;
    color: var(--secondary);
    letter-spacing: -1px;
  }

  .auth-heading {
    font-size: 3.6rem;
    font-weight: 800;
    color: var(--secondary);
    margin-bottom: 1.2rem;
    letter-spacing: -1.5px;
  }

  .auth-subheading {
    font-size: 1.6rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  /* ── Form Controls ── */
  .auth-form {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .input-group {
    position: relative;
  }

  .input-group i {
    position: absolute;
    left: 2rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-muted);
    font-size: 1.8rem;
    transition: color 0.3s;
  }

  .auth-input {
    width: 100%;
    padding: 1.8rem 2rem 1.8rem 5.6rem;
    border-radius: 1.6rem;
    border: 2px solid transparent;
    background: rgba(0, 0, 0, 0.03);
    font-size: 1.6rem;
    color: var(--secondary);
    transition: all 0.3s;
    outline: none;
  }

  .auth-input:focus {
    background: white;
    border-color: var(--primary);
    box-shadow: 0 10px 20px -5px rgba(41, 165, 163, 0.1);
  }

  .auth-input:focus + i {
    color: var(--primary);
  }

  .auth-error {
    background: #fff5f5;
    color: #c53030;
    padding: 1.6rem;
    border-radius: 1.2rem;
    font-size: 1.44rem;
    margin-bottom: 2.4rem;
    display: flex;
    align-items: center;
    gap: 1.2rem;
    border: 1px solid rgba(197, 48, 48, 0.1);
  }

  /* ── Buttons ── */
  .auth-btn-primary {
    background: var(--primary);
    color: white;
    padding: 1.8rem;
    border-radius: 1.6rem;
    font-weight: 700;
    font-size: 1.76rem;
    border: none;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 10px 25px -5px rgba(41, 165, 163, 0.4);
    margin-top: 1.2rem;
  }

  .auth-btn-primary:hover {
    background: var(--primary-dark);
    transform: translateY(-3px);
    box-shadow: 0 15px 30px -5px rgba(41, 165, 163, 0.5);
  }

  .auth-btn-secondary {
    background: transparent;
    color: var(--secondary);
    padding: 1.6rem;
    border-radius: 1.6rem;
    font-weight: 600;
    font-size: 1.6rem;
    border: 2px solid #e2e8f0;
    cursor: pointer;
    transition: all 0.3s;
  }

  .auth-btn-secondary:hover {
    background: #f8fafc;
    border-color: #cbd5e0;
  }

  .divider {
    display: flex;
    align-items: center;
    text-align: center;
    margin: 3.2rem 0;
    color: var(--text-muted);
    font-size: 1.44rem;
  }

  .divider::before, .divider::after {
    content: '';
    flex: 1;
    border-bottom: 1px solid #e2e8f0;
  }

  .divider:not(:empty)::before { margin-right: 1.6rem; }
  .divider:not(:empty)::after { margin-left: 1.6rem; }

  /* ── Right Side: Hero ── */
  .auth-right {
    flex: 1;
    background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
    padding: 6.4rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
    overflow: hidden;
    color: white;
  }

  .auth-right::after {
    content: '';
    position: absolute;
    top: -50%;
    right: -50%;
    width: 100%;
    height: 100%;
    background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
    border-radius: 50%;
  }

  .hero-content {
    position: relative;
    z-index: 2;
  }

  .hero-badge {
    display: inline-block;
    padding: 0.8rem 1.6rem;
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(10px);
    border-radius: 10rem;
    font-size: 1.44rem;
    font-weight: 600;
    margin-bottom: 3.2rem;
  }

  .hero-title {
    font-family: 'Playfair Display', serif;
    font-size: 5.6rem;
    line-height: 1.1;
    margin-bottom: 2.4rem;
    letter-spacing: -1px;
  }

  .hero-desc {
    font-size: 1.84rem;
    opacity: 0.9;
    line-height: 1.7;
  }

  .hero-image-wrap {
    position: relative;
    z-index: 2;
    margin-top: 4rem;
    transition: transform 0.5s ease;
  }



  .hero-image {
    width: 100%;
    border-radius: 3.2rem;
    box-shadow: 0 40px 80px -20px rgba(0, 0, 0, 0.3);
  }

  .auth-footer {
    margin-top: auto;
    text-align: center;
    font-size: 1.44rem;
    color: var(--text-muted);
  }

  .auth-footer a {
    color: var(--primary);
    font-weight: 600;
    text-decoration: none;
  }

  /* ── Responsive ── */
  @media (max-width: 1024px) {
    .auth-right { display: none; }
    .auth-wrapper { max-width: 500px; border-radius: 3.2rem; }
    .auth-left { padding: 4.8rem 3.2rem; }
  }

  @media (max-width: 480px) {
    .auth-page { padding: 0; }
    .auth-wrapper { border-radius: 0; min-height: 100vh; }
    .auth-left { padding: 4rem 2.4rem; }
    .auth-heading { font-size: 3rem; }
  }
</style>
{{/section}}

<div class="auth-page">
  <div class="auth-wrapper">
    
    <!-- Form Side -->
    <div class="auth-left">
      <div class="auth-header">
        <a href="/" class="auth-logo">
          <i class="fas fa-paper-plane"></i>
          <span>Travelo</span>
        </a>
        <h1 class="auth-heading">Join the journey.</h1>
        <p class="auth-subheading">Unlock exclusive deals, personalized itineraries, and manage your bookings with ease.</p>
      </div>

      {{#if error}}
        <div class="auth-error">
          <i class="fas fa-exclamation-circle"></i>
          <span>{{error}}</span>
        </div>
      {{/if}}

      <form class="auth-form" action="/auth/register" method="POST">
        <input type="hidden" name="_csrf" value="{{csrfToken}}">
        
        <div class="input-group">
          <input class="auth-input" placeholder="Full Name" id="name" name="name" type="text" autocomplete="name" required>
          <i class="fas fa-user"></i>
        </div>

        <div class="input-group">
          <input class="auth-input" placeholder="Email Address" id="email" name="email" type="email" required autocomplete="email">
          <i class="fas fa-envelope"></i>
        </div>

        <div class="input-group">
          <input class="auth-input" placeholder="Password (min 8 characters)" id="password" name="password" type="password" required minlength="8" autocomplete="new-password">
          <i class="fas fa-lock"></i>
        </div>

        <div class="input-group">
          <input class="auth-input" placeholder="Confirm Password" id="cpassword" name="cpassword" type="password" required autocomplete="new-password">
          <i class="fas fa-shield-alt"></i>
        </div>

        <button type="submit" class="auth-btn-primary">Create Your Account</button>
        
        <div class="divider">Already have an account?</div>
        
        <button type="submit" formaction="/auth/login" class="auth-btn-secondary">Sign In Instead</button>
      </form>

      <div class="auth-footer">
        <p>By continuing, you agree to Travelo's <a href="#">Terms of Service</a> and <a href="#">Privacy Policy</a>.</p>
      </div>
    </div>

    <!-- Hero Side -->
    <div class="auth-right">
      <div class="hero-content">
        <span class="hero-badge">✨ Over 50k+ Travelers</span>
        <h2 class="hero-title">Live Your Dream Life</h2>
        <p class="hero-desc">Discover hidden gems, luxury stays, and unforgettable adventures curated just for you.</p>
      </div>

      <div class="hero-image-wrap">
        <img src="/images/common/designer-2.png" alt="Travel" class="hero-image">
      </div>

      <div class="hero-quotes" style="margin-top: 4.8rem; font-style: italic; opacity: 0.8; font-size: 1.5rem;">
        "Travel is the only thing you buy that makes you richer."
      </div>
    </div>

  </div>
</div>