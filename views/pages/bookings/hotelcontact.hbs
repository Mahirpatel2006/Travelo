<style>

body { font-family: 'Inter', sans-serif !important; text-transform: none !important; }



/* ── Hotel Booking Page ─────────────────── */
.hbook-page {
  min-height: 100vh;
  background: #f9fbfc;
  padding: 8.8rem 0 9.6rem;
}

/* ── Breadcrumb ── */
.hbook-breadcrumb {
  max-width: 1180px;
  margin: 0 auto;
  padding: 0 2.4rem 1.6rem;
  font-size: 1.44rem;
  color: #4a5568;
  display: flex;
  align-items: center;
  gap: 0.8rem;
}
.hbook-breadcrumb a { color: #208886; text-decoration: none; }
.hbook-breadcrumb a:hover { text-decoration: underline; }

/* ── Split layout ── */
.hbook-layout {
  display: grid;
  grid-template-columns: 1fr 500px;
  gap: 0;
  max-width: 1180px;
  margin: 3.2rem auto 0;
  padding: 0 2.4rem;
  align-items: start;
}

/* ── Left info panel ── */
.hbook-info {
  padding-right: 5.6rem;
}

.hbook-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.8rem;
  font-size: 1.2rem;
  font-weight: 700;
  letter-spacing: 2px;
  text-transform: uppercase !important;
  color: #208886;
  background: rgba(41,165,163,.1);
  border: 1px solid rgba(41,165,163,.3);
  border-radius: 30px;
  padding: 0.64rem 1.76rem;
  margin-bottom: 2.4rem;
}

.hbook-title {
  font-family: 'Playfair Display', Georgia, serif !important;
  font-size: clamp(4rem, 4vw, 6rem);
  font-weight: 700;
  color: #1a202c;
  line-height: 1.12;
  margin-bottom: 1.76rem;
  text-transform: none !important;
}

.hbook-title span { color: #208886; }

.hbook-sub {
  font-size: 1.76rem;
  color: #4a5568;
  line-height: 1.8;
  margin-bottom: 4rem;
  max-width: 440px;
  text-transform: none !important;
}

/* features list */
.hbook-features {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 1.6rem;
  margin-bottom: 4rem;
  padding: 0;
}

.hbook-features li {
  display: flex;
  align-items: center;
  gap: 1.36rem;
  font-size: 1.6rem;
  color: #4a5568;
  text-transform: none !important;
}

.hbook-features li .feat-icon {
  width: 40px; height: 40px;
  border-radius: 10px;
  background: rgba(41,165,163,.1);
  border: 1px solid rgba(41,165,163,.2);
  display: flex; align-items: center; justify-content: center;
  color: #208886;
  font-size: 1.44rem;
  flex-shrink: 0;
}

/* stats row */
.hbook-stats {
  display: flex;
  gap: 4rem;
  padding-top: 3.2rem;
  border-top: 1px solid rgba(0,0,0,.08);
}

.hbook-stat-label { font-size: 1.28rem; color: #4a5568; text-transform: uppercase !important; letter-spacing: 1px; margin-top: 0.32rem; }
.hbook-stat-value { font-size: 2.88rem; font-weight: 800; color: #1a202c; text-transform: none !important; }
.hbook-stat-value span { font-size: 1.44rem; font-weight: 400; color: #208886; }

/* ── Form Card ── */
.hbook-card {
  background: #fff;
  border: 1px solid rgba(0,0,0,.08);
  border-radius: 20px;
  padding: 4.4rem;
  box-shadow: 0 20px 60px rgba(0,0,0,.06), 0 0 40px rgba(41,165,163,.04);
  position: sticky;
  top: 90px;
}

.hbook-card-header {
  margin-bottom: 2.4rem;
}

.hbook-card-title {
  font-size: 2.24rem;
  font-weight: 700;
  color: #1a202c;
  margin-bottom: 0.48rem;
  text-transform: none !important;
}

.hbook-card-sub {
  font-size: 1.48rem;
  color: #4a5568;
  text-transform: none !important;
}

/* destination badge inside card */
.hbook-dest-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.8rem;
  background: rgba(41,165,163,.1);
  border: 1px solid rgba(41,165,163,.3);
  color: #208886;
  font-size: 1.44rem;
  font-weight: 600;
  padding: 0.64rem 1.76rem;
  border-radius: 30px;
  margin-bottom: 2.4rem;
  text-transform: capitalize !important;
}

/* form rows */
.hbook-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.44rem; }

.hbook-field { display: flex; flex-direction: column; gap: 0.72rem; margin-bottom: 1.6rem; }
.hbook-field.full { grid-column: 1 / -1; }

.hbook-label {
  font-size: 1.28rem;
  font-weight: 600;
  letter-spacing: .75px;
  text-transform: uppercase !important;
  color: #4a5568;
}

.hbook-input {
  width: 100%;
  background: #f8fafb;
  border: 1.5px solid rgba(0,0,0,.12);
  border-radius: 10px;
  padding: 1.44rem 1.76rem;
  font-size: 1.6rem;
  color: #1a202c;
  font-family: inherit;
  outline: none;
  transition: border-color .2s, box-shadow .2s, background .2s;
  text-transform: none !important;
}

.hbook-input:focus {
  border-color: #29a5a3;
  box-shadow: 0 0 0 3px rgba(41,165,163,.12);
  background: #fff;
}

.hbook-input::placeholder { color: #a0aec0; }

/* date grid */
.hbook-dates { display: grid; grid-template-columns: 1fr 1fr; gap: 1.44rem; }

/* price breakdown */
.hbook-price-box {
  background: rgba(41,165,163,.06);
  border: 1px solid rgba(41,165,163,.18);
  border-radius: 12px;
  padding: 1.76rem 2.08rem;
  margin: 0.8rem 0 2rem;
}

.hbook-price-row {
  display: flex;
  justify-content: space-between;
  font-size: 1.44rem;
  color: #4a5568;
  padding: 0.48rem 0;
  text-transform: none !important;
}

.hbook-price-row.total {
  color: #1a202c;
  font-weight: 700;
  font-size: 1.6rem;
  border-top: 1px solid rgba(0,0,0,.08);
  margin-top: 0.8rem;
  padding-top: 1.28rem;
}

.hbook-price-row.total .val { color: #208886; font-size: 1.76rem; }

/* submit btn */
.hbook-submit {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 1.04rem;
  width: 100%;
  padding: 1.68rem 2.4rem;
  background: linear-gradient(135deg, #29a5a3, #1e7e7c);
  color: #fff;
  font-size: 1.68rem;
  font-weight: 700;
  font-family: inherit;
  border: none;
  border-radius: 12px;
  cursor: pointer;
  transition: all .25s;
  letter-spacing: .3px;
  text-transform: none !important;
}

.hbook-submit:hover {
  transform: translateY(-2px);
  box-shadow: 0 10px 28px rgba(41,165,163,.35);
}

.hbook-submit:active { transform: translateY(0); }

.hbook-secure {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.72rem;
  font-size: 1.4rem;
  color: #718096;
  margin-top: 1.6rem;
  text-transform: none !important;
}

/* ── Payment Success Modal ── */
.pay-success-overlay {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(15,23,42,.55);
  backdrop-filter: blur(6px);
  z-index: 9999;
  align-items: center;
  justify-content: center;
}
.pay-success-overlay.active { display: flex; }

.pay-success-modal {
  background: #fff;
  border-radius: 24px;
  padding: 4.8rem 4.4rem;
  max-width: 480px;
  width: 92%;
  text-align: center;
  box-shadow: 0 40px 100px rgba(0,0,0,.2);
  animation: modalPop .4s cubic-bezier(.34,1.56,.64,1);
}

@keyframes modalPop {
  from { opacity:0; transform:scale(.8) translateY(30px); }
  to   { opacity:1; transform:scale(1) translateY(0); }
}

.pay-success-icon {
  width: 84px; height: 84px;
  border-radius: 50%;
  background: linear-gradient(135deg, #29a5a3, #1e7e7c);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 2.4rem;
  font-size: 3.6rem;
  color: #fff;
  box-shadow: 0 12px 32px rgba(41,165,163,.4);
}

.pay-success-title {
  font-family: 'Playfair Display', Georgia, serif !important;
  font-size: 3.04rem;
  font-weight: 700;
  color: #1a202c;
  margin-bottom: 0.96rem;
  text-transform: none !important;
}

.pay-success-sub {
  font-size: 1.6rem;
  color: #4a5568;
  line-height: 1.75;
  margin-bottom: 2.4rem;
  text-transform: none !important;
}

.pay-success-ref {
  display: inline-block;
  background: rgba(41,165,163,.08);
  border: 1px solid rgba(41,165,163,.25);
  color: #208886;
  font-size: 1.44rem;
  font-weight: 600;
  padding: 0.8rem 2.4rem;
  border-radius: 30px;
  margin-bottom: 3.2rem;
  text-transform: none !important;
  font-family: 'Courier New', monospace;
  letter-spacing: 1px;
}

.pay-success-divider {
  border: none;
  border-top: 1px solid rgba(0,0,0,.08);
  margin: 2.4rem 0;
}

.pay-success-details {
  display: flex;
  justify-content: space-around;
  margin-bottom: 2.8rem;
}

.pay-success-detail-item { text-align: center; }
.pay-success-detail-label {
  font-size: 1.2rem;
  color: #718096;
  text-transform: uppercase !important;
  letter-spacing: 1px;
  margin-bottom: 0.4rem;
}
.pay-success-detail-value {
  font-size: 1.6rem;
  font-weight: 600;
  color: #1a202c;
  text-transform: none !important;
}

.pay-success-btn {
  display: inline-block;
  background: linear-gradient(135deg, #29a5a3, #1e7e7c);
  color: #fff;
  font-size: 1.6rem;
  font-weight: 700;
  padding: 1.44rem 4.4rem;
  border-radius: 12px;
  border: none;
  cursor: pointer;
  transition: all .2s;
  text-transform: none !important;
  font-family: inherit;
}
.pay-success-btn:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(41,165,163,.35); }

/* ── Responsive ── */
@media (max-width: 900px) {
  .hbook-layout { grid-template-columns: 1fr; }
  .hbook-info { padding-right: 0; margin-bottom: 3.2rem; }
  .hbook-card { position: static; }
}
@media (max-width: 520px) {
  .hbook-row, .hbook-dates { grid-template-columns: 1fr; }
  .hbook-stats { flex-direction: column; gap: 2rem; }
  .pay-success-details { flex-direction: column; gap: 1.6rem; }
}
</style>

<!-- Payment Success Modal -->
<div class="pay-success-overlay" id="pay-success-overlay">
  <div class="pay-success-modal">
    <div class="pay-success-icon"><i class="fas fa-check"></i></div>
    <div class="pay-success-title">Hotel Booked! 🏨</div>
    <p class="pay-success-sub">Your hotel reservation has been confirmed. You'll receive a booking confirmation email shortly.</p>
    <div class="pay-success-ref" id="pay-success-ref">TXN-XXXXXXXX</div>
    <hr class="pay-success-divider">
    <div class="pay-success-details">
      <div class="pay-success-detail-item">
        <div class="pay-success-detail-label">Destination</div>
        <div class="pay-success-detail-value" id="psd-destination">—</div>
      </div>
      <div class="pay-success-detail-item">
        <div class="pay-success-detail-label">Amount Paid</div>
        <div class="pay-success-detail-value" id="psd-amount">₹4,130</div>
      </div>
      <div class="pay-success-detail-item">
        <div class="pay-success-detail-label">Status</div>
        <div class="pay-success-detail-value" style="color:#29a5a3;">✓ Confirmed</div>
      </div>
    </div>
    <button class="pay-success-btn" onclick="window.location.href='/'">Back to Home</button>
  </div>
</div>

<div class="hbook-page">

  <!-- Breadcrumb -->
  <nav class="hbook-breadcrumb" aria-label="Breadcrumb">
    <a href="/"><i class="fas fa-home"></i></a>
    <i class="fas fa-chevron-right" style="font-size:1.12rem;color:#a0aec0"></i>
    <a href="/affordable-hotels">Hotels</a>
    <i class="fas fa-chevron-right" style="font-size:1.12rem;color:#a0aec0"></i>
    <span style="text-transform:capitalize">{{destination}}</span>
  </nav>

  <div class="hbook-layout">

    <!-- Left: Info panel -->
    <div class="hbook-info">
      <div class="hbook-badge"><i class="fas fa-hotel"></i> Hotel Reservation</div>
      <h1 class="hbook-title">
        Stay in<br><span>{{destination}}</span>
      </h1>
      <p class="hbook-sub">
        Find and book the perfect hotel for your stay. We partner with premium properties across India to offer you an unforgettable experience at the best value.
      </p>

      <ul class="hbook-features">
        <li>
          <span class="feat-icon"><i class="fas fa-shield-alt"></i></span>
          Secure, verified bookings — pay safely via Razorpay
        </li>
        <li>
          <span class="feat-icon"><i class="fas fa-ban"></i></span>
          Free cancellation on most properties up to 48 hrs prior
        </li>
        <li>
          <span class="feat-icon"><i class="fas fa-headset"></i></span>
          24/7 customer support throughout your journey
        </li>
        <li>
          <span class="feat-icon"><i class="fas fa-star"></i></span>
          Only curated 3-star to 5-star rated properties
        </li>
        <li>
          <span class="feat-icon"><i class="fas fa-tag"></i></span>
          Best price guarantee — no hidden fees
        </li>
      </ul>

      <div class="hbook-stats">
        <div>
          <div class="hbook-stat-value">10k+ <span>guests</span></div>
          <div class="hbook-stat-label">Served this year</div>
        </div>
        <div>
          <div class="hbook-stat-value">50+ <span>hotels</span></div>
          <div class="hbook-stat-label">Partner properties</div>
        </div>
        <div>
          <div class="hbook-stat-value">4.8 <span>★</span></div>
          <div class="hbook-stat-label">Average rating</div>
        </div>
      </div>
    </div>

    <!-- Right: Form card -->
    <div class="hbook-card">
      <div class="hbook-card-header">
        <div class="hbook-card-title">Complete Your Reservation</div>
        <div class="hbook-card-sub">Fill in the details below to confirm your stay</div>
      </div>

      <div class="hbook-dest-badge">
        <i class="fas fa-map-marker-alt"></i> {{destination}}
      </div>

      <form id="hotel-booking-form" action="/booking/hotel/{{destination}}" method="POST">
        <input type="hidden" name="_csrf" value="{{csrfToken}}">

        <div class="hbook-row">
          <div class="hbook-field">
            <label class="hbook-label" for="hb-name">Full Name</label>
            <input class="hbook-input" id="hb-name" type="text" name="hname" placeholder="e.g. Rahul Mehta" required>
          </div>
          <div class="hbook-field">
            <label class="hbook-label" for="hb-guests">Guests</label>
            <input class="hbook-input" id="hb-guests" type="number" name="hpnumber" placeholder="2" min="1" max="20" required>
          </div>
        </div>

        <div class="hbook-dates hbook-field">
          <div>
            <label class="hbook-label" for="hb-checkin">Check-In</label>
            <input class="hbook-input" id="hb-checkin" type="date" name="hadate" required>
          </div>
          <div>
            <label class="hbook-label" for="hb-checkout">Check-Out</label>
            <input class="hbook-input" id="hb-checkout" type="date" name="hlday" required>
          </div>
        </div>

        <div class="hbook-row">
          <div class="hbook-field">
            <label class="hbook-label" for="hb-email">Email *</label>
            <input class="hbook-input" id="hb-email" type="email" name="hconemail" placeholder="you@email.com" required>
          </div>
          <div class="hbook-field">
            <label class="hbook-label" for="hb-phone">Phone *</label>
            <input class="hbook-input" id="hb-phone" type="tel" name="hconnumber" placeholder="10-digit number" required>
          </div>
        </div>

        <div class="hbook-price-box">
          <div class="hbook-price-row"><span>Base rate / night</span><span>₹3,500</span></div>
          <div class="hbook-price-row"><span>Taxes &amp; service fees</span><span>₹630</span></div>
          <div class="hbook-price-row total"><span>Estimated total</span><span class="val">₹4,130 / night</span></div>
        </div>

        <button type="button" id="pay-button" class="hbook-submit">
          <i class="fas fa-lock"></i> Pay &amp; Confirm Booking
        </button>
      </form>

      <div class="hbook-secure">
        <i class="fas fa-shield-alt" style="color:#29a5a3"></i>
        256-bit SSL encrypted · Powered by Razorpay
      </div>
    </div>

  </div>
</div>

<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script>
  // Set min date to today for date inputs
  const today = new Date().toISOString().split('T')[0];
  document.getElementById('hb-checkin').min = today;
  document.getElementById('hb-checkout').min = today;

  document.getElementById('hb-checkin').addEventListener('change', function() {
    document.getElementById('hb-checkout').min = this.value;
  });

  function showSuccessModal(paymentId, destination, amount) {
    document.getElementById('pay-success-ref').textContent = 'TXN-' + paymentId.slice(-8).toUpperCase();
    document.getElementById('psd-destination').textContent = destination || '—';
    document.getElementById('psd-amount').textContent = '₹' + (amount || '4,130');
    document.getElementById('pay-success-overlay').classList.add('active');
  }

  document.getElementById('pay-button').addEventListener('click', async function (e) {
    e.preventDefault();
    const form = document.getElementById('hotel-booking-form');
    if (!form.checkValidity()) { form.reportValidity(); return; }

    const btn = document.getElementById('pay-button');
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Processing...';

    try {
      const order = await fetch('/booking/create-order', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': document.querySelector('[name="_csrf"]').value },
        body: JSON.stringify({ amount: 4130, destination: '{{destination}}' })
      }).then(r => r.json());

      if (!order || !order.id) {
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-lock"></i> Pay & Confirm Booking';
        alert('Failed to create order. Please try again.');
        return;
      }

      const options = {
        key: '{{razorpayKeyId}}',
        amount: order.amount,
        currency: order.currency,
        name: 'Travelo Hotel Booking',
        description: 'Hotel stay in {{destination}}',
        order_id: order.id,
        handler: async function (response) {
          const data = Object.fromEntries(new FormData(form));
          const res = await fetch('/booking/hotel-verify-save', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': data._csrf },
            body: JSON.stringify({ ...data, destination: '{{destination}}', ...response, totalAmount: order.amount / 100 })
          });
          if (res.ok) {
            showSuccessModal(response.razorpay_payment_id, '{{destination}}', '4,130');
          } else {
            const errData = await res.json().catch(() => ({}));
            alert('Booking confirmation failed: ' + (errData.error || 'Contact support.'));
          }
        },
        modal: {
          ondismiss: function() {
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-lock"></i> Pay & Confirm Booking';
          }
        },
        prefill: {
          name: document.getElementById('hb-name').value,
          email: document.getElementById('hb-email').value,
          contact: document.getElementById('hb-phone').value,
        },
        theme: { color: '#29a5a3' },
      };
      new Razorpay(options).open();
    } catch (err) {
      btn.disabled = false;
      btn.innerHTML = '<i class="fas fa-lock"></i> Pay & Confirm Booking';
      alert('Payment error. Please try again.');
    }
  });
</script>